# Copy this file to `.env` and fill in your real values. Never commit `.env` itself.

# --- Embeddings ---
# "local"  = free, runs on your machine, no API key needed (good for dev/testing)
# "voyage" = Anthropic's recommended embedding provider, needs VOYAGE_API_KEY
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=

# --- LLM (needed now, for backend/rag/ask.py) ---
# "gemini"    = free tier available, no credit card needed -- get a key at https://aistudio.google.com/apikey
# "anthropic" = Claude, higher quality, needs paid API credits -- https://console.anthropic.com/settings/keys
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional override -- defaults to gemini-flash-lite-latest (most generous free quota).
# GEMINI_MODEL=gemini-flash-lite-latest
ANTHROPIC_API_KEY=

# --- Vector store ---
CHROMA_PERSIST_DIR=./backend/data/vector_store

# --- API security ---
# Required to call the backend API at all. Generate any random string,
# e.g. by running: python -c "import secrets; print(secrets.token_hex(24))"
API_ACCESS_KEY=
